# Bold Payment Gateway
BOLD_API_KEY=tu_api_key_bold
BOLD_PUBLIC_KEY=tu_public_key_bold
BOLD_API_SECRET=tu_api_secret_bold

# Mercado Pago Configuration
MERCADO_PAGO_ACCESS_TOKEN=tu_access_token_de_mercado_pago
