# Base de Datos
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/lushsecret

# Servidor
PORT=4000

# JWT
JWT_SECRET=tu_secreto_jwt_aqui

# Email Configuration (para notificaciones de tracking)
